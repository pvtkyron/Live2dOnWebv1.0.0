{
  "name": "live2dweb",
  "version": "1.0.0",
  "private": true,
  "description": "Project Revの静的ストア、Blogfa互換ランタイム、Live2D Web表示レイヤー。",
  "homepage": "https://pvtkyron.github.io/Live2dOnWebv1.0.0/",
  "repository": {"type": "git", "url": "https://github.com/pvtkyron/Live2dOnWebv1.0.0.git"},
  "keywords": ["live2d","project-rev","static-site","blogfa","storefront"],
  "scripts": {
    "start": "webpack-dev-server --progress --devtool inline-source-map",
    "build": "webpack --mode development --devtool inline-source-map",
    "build:prod": "webpack --mode production",
    "check:static": "node scripts/validate-static-site.js",
    "check:ja": "node scripts/check-japanese-localization.js",
    "check:blogfa": "node scripts/check-blogfa-responsive.js",
    "check:type": "node scripts/check-typography.js",
    "serve": "serve -p 5001",
    "clean": "rimraf dist",
    "cf:dev": "npx wrangler@latest dev",
    "cf:deploy": "npx wrangler@latest deploy",
    "cf:dry-run": "npx wrangler@latest deploy --dry-run"
  },
  "author": "Konata",
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^2.18.0",
    "@typescript-eslint/parser": "^2.18.0",
    "compression-webpack-plugin": "^7.1.2",
    "eslint": "^6.8.0",
    "eslint-plugin-prettier": "^3.1.2",
    "expose-loader": "^1.0.0",
    "prettier": "^1.19.1",
    "raw-loader": "^4.0.1",
    "rimraf": "^3.0.1",
    "serve": "^11.3.0",
    "ts-loader": "^6.2.1",
    "typescript": "^3.7.5",
    "webpack": "^5.22",
    "webpack-cli": "^4.5",
    "webpack-dev-server": "^3.11.2"
  },
  "dependencies": {"whatwg-fetch": "^3.0.0"}
}
